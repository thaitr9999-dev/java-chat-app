# 1. Register
$reg = Invoke-RestMethod -Uri "http://localhost:8080/auth/register" `
  -Method POST -ContentType "application/json" `
  -Body '{"username":"test","password":"123"}'

# 2. Login
$login = Invoke-RestMethod -Uri "http://localhost:8080/auth/login" `
  -Method POST -ContentType "application/json" `
  -Body '{"username":"test","password":"123"}'
$token = $login.token

# 3. Upload
curl -X POST "http://localhost:8080/api/upload" `
  -H "Authorization: Bearer $token" `
  -F "file=@truong.jpg"
# Response: {"url":"/uploads/uuid.jpg"}

# 4. Access (công khai)
curl "http://localhost:8080/uploads/uuid.jpg"
# Status 200 - File accessible
```

